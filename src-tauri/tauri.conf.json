{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelCraftStudio-1.0.1-Build-2",
  "version": "1.0.1",
  "identifier": "studio.longtoshot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReelCraftStudio-1.0.1-Build-2",
        "decorations": false,
        "width": 1500,
        "height": 940,
        "minWidth": 1120,
        "minHeight": 720,
        "backgroundColor": "#f5f5f7"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "shortDescription": "ReelCraft Studio ? split, frame, and export your videos.",
    "category": "Video",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
